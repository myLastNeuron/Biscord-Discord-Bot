# Discord Bot Configuration:
                       ---------------------------------------------
# Get your token from: |https://discord.com/developers/applications|
                       ---------------------------------------------


DISCORD_TOKEN= your_bot_token_here

# Bot's Client ID (Application ID)
CLIENT_ID= your_client_id_here

# Guild ID for guild-specific features (optional)
GUILD_ID= your_guild_id_here

# Stats channel IDs for member/online counters (optional)
STATS_MEMBERS_CHANNEL_ID= 
STATS_ONLINE_CHANNEL_ID= 

# Music bot Linux support - For Web Hosting (Linux-based hosting)
# OPTIONAL. Leave these commented out unless you're on a Linux host that needs
# explicit paths: the bot auto-detects the bundled binaries for the current OS
# (including the .exe suffix on Windows). Setting them to Linux paths on
# Windows makes ffmpeg-static return a non-existent file and prints a warning.
# YT_DLP_BINARY_PATH=./node_modules/@distube/yt-dlp/bin/yt-dlp
# FFMPEG_BIN=./node_modules/ffmpeg-static/ffmpeg

# YouTube cookies (recommended on VPS / datacenter hosts).
# If music fails with "Sign in to confirm you're not a bot", export cookies
# from a logged-in browser in Netscape format to a cookies.txt file and point
# this at it. The file is a login secret - keep it out of version control.
# YTDLP_COOKIES=./cookies.txt

# Advanced yt-dlp tuning (optional)
# YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=default
# YTDLP_NO_FORCE_IPV4=1