# Discord Bot Configuration:
                       ---------------------------------------------
# Get your token from: |https://discord.com/developers/applications|
                       ---------------------------------------------


DISCORD_TOKEN= your_bot_token_here

# Bot's Client ID (Application ID)
CLIENT_ID= your_client_id_here

# Guild ID for guild-specific features (optional)
GUILD_ID= your_guild_id_here

# Stats channel IDs for member/online counters (optional)
STATS_MEMBERS_CHANNEL_ID= 
STATS_ONLINE_CHANNEL_ID= 

# Music (yt-dlp). scripts/ensure-deps.js downloads yt-dlp into ./bin on first
# start and verifies its SHA-256 before running it (fail-closed). Override or
# pin with these (all optional):
#   YTDLP_PATH=/custom/yt-dlp        use your own binary instead of the download
#   YTDLP_URL=<url>                  download from somewhere other than GitHub
#   YTDLP_SHA256=<hex>               pin an exact digest for the download
#   YTDLP_CHECKSUM_URL=<url>         custom SHA256SUMS manifest
#   YTDLP_SKIP_CHECKSUM=1            skip verification (NOT recommended)
#   YTDLP_DISABLE_DOWNLOAD=1         never download (expect a PATH/override binary)

# YouTube cookies (recommended on VPS / datacenter hosts).
# If music fails with "Sign in to confirm you're not a bot", export cookies
# from a logged-in browser in Netscape format to a cookies.txt file and point
# this at it. The file is a login secret - keep it out of version control.
# YTDLP_COOKIES=./cookies.txt